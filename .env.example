# Copy to .env for local use, or paste these as Railway Variables.
# .env is git-ignored. Never commit real keys.

# ---------------------------------------------------------------- SMM panel
API_KEY=REPLACE_WITH_YOUR_GOD_OF_PANEL_KEY
PANEL_URL=https://godofpanel.com/api/v2
SERVICE_ID=5836
# How long service min/max/rate is cached before a refresh (seconds).
SERVICE_METADATA_TTL_SECONDS=900

# ------------------------------------------------------------ selection rules
KEYWORD=Mael Vorran
# all = top-level comments and their replies. top_level = top-level only.
COMMENT_SCOPE=all
# Default mode for a fresh install. The dashboard always starts on Dry run.
RUN_MODE=dry_run

# --------------------------------------------------------- comment reader
# scrapecreators = the real integration (default). Needs only READER_API_KEY.
# http           = generic adapter for another provider, needs a contract file.
# fixture        = local demo samples. Never live, never an automatic fallback.
COMMENT_READER=scrapecreators
READER_BASE_URL=https://api.scrapecreators.com
READER_API_KEY=REPLACE_WITH_YOUR_SCRAPECREATORS_KEY
READER_API_KEY_HEADER=x-api-key
# Only the generic "http" adapter uses this. Leave empty for scrapecreators.
READER_CONTRACT_FILE=
READER_FIXTURE_DIR=tests/fixtures/comments
# Ignored by scrapecreators: that endpoint documents no page-size parameter.
READER_PAGE_SIZE=50
READER_TIMEOUT_SECONDS=15
READER_MAX_CONNECTIONS=10
# Ask the provider for a trimmed response. Keep false: the full response is
# what carries the fields this application depends on.
READER_TRIM=false
# How long a resolved owner handle may be reused (seconds).
READER_OWNER_CACHE_TTL_SECONDS=3600
# Documented profile cache window; a cache hit costs 0 credits.
READER_PROFILE_CACHE_MAX_AGE=7d

# ------------------------------------------------------------- scan budgets
# Hitting any of these marks the scan incomplete and blocks ordering.
SCAN_DEADLINE_SECONDS=90
SCAN_MAX_PAGES=60
SCAN_MAX_REQUESTS=120
SCAN_MAX_COMMENTS=5000
SCAN_MAX_THREADS=200
# false (default, strict): if a parent advertises more replies than arrive, the
# scan is incomplete and nothing is ordered. true is an explicit opt-in that
# reinterprets "complete" as provider-visible data only; the dashboard then
# labels every affected result. Read the README before changing this.
SCAN_TRUST_PROVIDER_REPLY_END=false

# --------------------------------------------------------------------- auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET
SESSION_TTL_SECONDS=86400
# Keep true in production (HTTPS). Set false only for plain-http local testing.
COOKIE_SECURE=true

# ------------------------------------------------------------------ storage
# Railway: /data/app.db with a volume mounted at /data.
# Local:   ./data/app.db
DATABASE_PATH=/data/app.db

# ------------------------------------------------------- delivery tracking
STATUS_POLL_INTERVAL_SECONDS=60
STATUS_POLL_BATCH_SIZE=20

# production enforces real ADMIN_PASSWORD and SESSION_SECRET values.
ENVIRONMENT=production
MAX_LINKS_PER_BATCH=10
